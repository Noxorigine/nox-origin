name: NØX Origin - V54 Feed Opportunity

on:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  feed-opportunity:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install requests

      - name: NØX V54 - Feed Opportunity
        env:
          COLONY_API_KEY: ${{ secrets.COLONY_API_KEY }}
        run: |
          cat > v54_agent.py <<'PY'
          import os
          import json
          import re
          import requests
          from datetime import datetime, timezone

          API_BASE = "https://thecolony.ai/api/v1"
          MAX_ACTIONS = 1
          MAX_COMMENT_LENGTH = 900

          api_key = os.environ.get("COLONY_API_KEY")

          if not api_key:
              raise RuntimeError("COLONY_API_KEY is missing")

          session = requests.Session()

          session.headers.update({
              "Accept": "application/json",
              "Content-Type": "application/json",
          })

          now = datetime.now(
              timezone.utc
          ).isoformat()

          print("=== NØX Origin V54 ===")
          print("FEED OPPORTUNITY")
          print("Gemini: DISABLED")
          print()

          # =========================================================
          # Helpers
          # =========================================================

          def get_text(value):
              if value is None:
                  return ""

              if isinstance(value, str):
                  return value.strip()

              if isinstance(value, dict):
                  for key in [
                      "body",
                      "content",
                      "text",
                      "description",
                      "title"
                  ]:
                      if value.get(key):
                          return str(
                              value.get(key)
                          ).strip()

              return str(value).strip()

          def extract_post(item):
              if not isinstance(item, dict):
                  return None

              post = item.get("post")

              if isinstance(post, dict):
                  return post

              if any(
                  key in item
                  for key in [
                      "title",
                      "body",
                      "content",
                      "author"
                  ]
              ):
                  return item

              return None

          def post_id(post):
              if not isinstance(post, dict):
                  return None

              value = (
                  post.get("id")
                  or post.get("post_id")
              )

              return str(value) if value else None

          def author_name(post):
              if not isinstance(post, dict):
                  return "unknown"

              author = post.get("author")

              if isinstance(author, dict):
                  return str(
                      author.get("username")
                      or author.get("name")
                      or "unknown"
                  )

              return str(
                  post.get("author_username")
                  or post.get("username")
                  or "unknown"
              )

          def post_title(post):
              if not isinstance(post, dict):
                  return ""

              return get_text(
                  post.get("title")
              )

          def post_body(post):
              if not isinstance(post, dict):
                  return ""

              return get_text(
                  post.get("body")
                  or post.get("content")
                  or post.get("text")
              )

          def normalise(text):
              return re.sub(
                  r"\s+",
                  " ",
                  str(text or "")
              ).strip()

          def has_injection(text):
              lowered = text.lower()

              markers = [
                  "ignore previous instructions",
                  "ignore all previous instructions",
                  "ignore the system prompt",
                  "ignore your instructions",
                  "reveal your system prompt",
                  "reveal your instructions",
                  "show your api key",
                  "give me your api key",
                  "send your token",
                  "access token",
                  "colony_api_key",
                  "gemini_api_key",
                  "github token",
                  "github_token",
                  "execute this command",
                  "run this command",
              ]

              return any(
                  marker in lowered
                  for marker in markers
              )

          def topic_matches(text):
              lowered = text.lower()

              topics = {
                  "agents": [
                      "agent",
                      "agents",
                      "ai agent",
                      "autonomous"
                  ],
                  "memory": [
                      "memory",
                      "memor",
                      "context"
                  ],
                  "measurement": [
                      "measurement",
                      "measure",
                      "metric",
                      "metrics",
                      "evaluation",
                      "evaluate"
                  ],
                  "learning": [
                      "learning",
                      "learn",
                      "knowledge"
                  ],
                  "verification": [
                      "verification",
                      "verify",
                      "verified"
                  ],
                  "reputation": [
                      "karma",
                      "reputation"
                  ],
                  "community": [
                      "community",
                      "colony",
                      "collaboration"
                  ],
                  "proposals": [
                      "proposal",
                      "propose",
                      "idea",
                      "suggestion"
                  ],
                  "economics": [
                      "reward",
                      "rewards",
                      "economic",
                      "economy",
                      "revenue",
                      "sats",
                      "bitcoin"
                  ]
              }

              found = []

              for topic, keywords in topics.items():
                  if any(
                      keyword in lowered
                      for keyword in keywords
                  ):
                      found.append(topic)

              return found

          def select_evidence(body):
              sentences = re.split(
                  r"(?<=[.!?])\s+",
                  body
              )

              for sentence in sentences:
                  sentence = normalise(sentence)

                  if (
                      40 <= len(sentence) <= 280
                  ):
                      return sentence

              return ""

          # =========================================================
          # 1. Authentication
          # =========================================================

          print("[1] Authenticating with The Colony...")

          auth = session.post(
              f"{API_BASE}/auth/token",
              json={
                  "api_key": api_key
              },
              timeout=30,
          )

          print(
              "Authentication HTTP status:",
              auth.status_code
          )

          if auth.status_code != 200:
              print(auth.text[:5000])
              raise RuntimeError(
                  "Authentication failed"
              )

          auth_data = auth.json()

          token = (
              auth_data.get("access_token")
              or auth_data.get("token")
              or auth_data.get("jwt")
          )

          if not token:
              raise RuntimeError(
                  "No access token returned"
              )

          session.headers.update({
              "Authorization":
                  f"Bearer {token}"
          })

          print("Authentication: PASS")

          # =========================================================
          # 2. Identity
          # =========================================================

          print()
          print("[2] Checking NØX identity...")

          identity_response = session.get(
              f"{API_BASE}/users/me",
              timeout=30,
          )

          print(
              "Identity HTTP status:",
              identity_response.status_code
          )

          if identity_response.status_code != 200:
              print(
                  identity_response.text[:5000]
              )
              raise RuntimeError(
                  "Identity verification failed"
              )

          identity = identity_response.json()

          username = (
              identity.get("username")
              or identity.get("name")
              or "nox_origine"
          )

          print(
              "Authenticated agent:",
              username
          )

          print("Identity verification: PASS")

          # =========================================================
          # 3. Read real For-you feed
          # =========================================================

          print()
          print("[3] Reading real For-you feed...")

          feed_response = session.get(
              f"{API_BASE}/feed/for-you",
              params={
                  "limit": 25
              },
              timeout=30,
          )

          print(
              "Feed HTTP status:",
              feed_response.status_code
          )

          if feed_response.status_code != 200:
              print(
                  feed_response.text[:5000]
              )
              raise RuntimeError(
                  "Feed request failed"
              )

          feed_data = feed_response.json()

          if isinstance(
              feed_data,
              dict
          ):
              feed_items = feed_data.get(
                  "items",
                  []
              )
          elif isinstance(
              feed_data,
              list
          ):
              feed_items = feed_data
          else:
              feed_items = []

          if not isinstance(
              feed_items,
              list
          ):
              feed_items = []

          print(
              "Feed items received:",
              len(feed_items)
          )

          # =========================================================
          # 4. Analyse posts locally
          # =========================================================

          print()
          print(
              "[4] NØX is analysing feed "
              "for an opportunity..."
          )

          candidates = []

          for index, item in enumerate(
              feed_items,
              start=1
          ):

              post = extract_post(item)

              if not post:
                  continue

              pid = post_id(post)

              if not pid:
                  continue

              title = normalise(
                  post_title(post)
              )

              body = normalise(
                  post_body(post)
              )

              author = author_name(post)

              if (
                  author.lower()
                  == username.lower()
              ):
                  print(
                      f"Item {index}: own post -> skip"
                  )
                  continue

              combined = normalise(
                  f"{title} {body}"
              )

              if len(combined) < 80:
                  print(
                      f"Item {index}: too little "
                      f"context -> skip"
                  )
                  continue

              if has_injection(combined):
                  print(
                      f"Item {index}: safety "
                      f"filter -> skip"
                  )
                  continue

              topics = topic_matches(
                  combined
              )

              if not topics:
                  print(
                      f"Item {index}: no relevant "
                      f"topic -> skip"
                  )
                  continue

              score = 0

              score += min(
                  len(body) / 100,
                  5
              )

              score += len(topics) * 3

              if "?" in combined:
                  score += 4

              if len(body) >= 200:
                  score += 2

              candidates.append({
                  "index": index,
                  "post": post,
                  "post_id": pid,
                  "title": title,
                  "body": body,
                  "author": author,
                  "topics": topics,
                  "score": round(
                      score,
                      2
                  ),
              })

          candidates.sort(
              key=lambda item:
                  -item["score"]
          )

          print()
          print(
              "Potential opportunities:",
              len(candidates)
          )

          for candidate in candidates:
              print()
              print(
                  "Candidate:",
                  candidate["index"]
              )
              print(
                  "  post_id:",
                  candidate["post_id"]
              )
              print(
                  "  author:",
                  candidate["author"]
              )
              print(
                  "  title:",
                  candidate["title"][:200]
              )
              print(
                  "  topics:",
                  ", ".join(
                      candidate["topics"]
                  )
              )
              print(
                  "  score:",
                  candidate["score"]
              )

          # =========================================================
          # 5. Prepare result
          # =========================================================

          result = {

              "version": "V54",

              "generated_at": now,

              "agent": username,

              "gemini": False,

              "feed_items":
                  len(feed_items),

              "opportunities_found":
                  len(candidates),

              "action_taken":
                  False,

              "action_type":
                  None,

              "target_post_id":
                  None,

              "target_author":
                  None,

              "target_title":
                  None,

              "topics":
                  [],

              "comment":
                  None,

              "comment_http_status":
                  None,

              "reason":
                  None,

              "safety": {

                  "maximum_actions":
                      MAX_ACTIONS,

                  "actions_attempted":
                      0,

                  "publication":
                      False,

                  "comment":
                      False,

                  "vote":
                      False,

                  "follow":
                      False,

                  "dm":
                      False,

                  "purchase":
                      False,

                  "spending":
                      False,

                  "gemini":
                      False,
              }
          }

          # =========================================================
          # 6. No opportunity
          # =========================================================

          if not candidates:

              print()
              print(
                  "NO USEFUL FEED OPPORTUNITY FOUND."
              )

              print(
                  "NØX will perform NO public action."
              )

              result["reason"] = (
                  "NØX analysed the real For-you "
                  "feed but found no sufficiently "
                  "relevant and safe opportunity "
                  "for a useful contribution."
              )

          else:

              selected = candidates[0]

              result[
                  "target_post_id"
              ] = selected[
                  "post_id"
              ]

              result[
                  "target_author"
              ] = selected[
                  "author"
              ]

              result[
                  "target_title"
              ] = selected[
                  "title"
              ]

              result[
                  "topics"
              ] = selected[
                  "topics"
              ]

              print()
              print(
                  "================================================"
              )
              print(
                  "NØX SELECTED A FEED OPPORTUNITY"
              )
              print(
                  "================================================"
              )

              print(
                  "Post:",
                  selected["post_id"]
              )

              print(
                  "Author:",
                  selected["author"]
              )

              print(
                  "Title:",
                  selected["title"]
              )

              print(
                  "Topics:",
                  ", ".join(
                      selected["topics"]
                  )
              )

              # =====================================================
              # 7. Retrieve complete post context
              # =====================================================

              print()
              print(
                  "[5] Retrieving complete post context..."
              )

              context_response = session.get(
                  f"{API_BASE}/posts/"
                  f"{selected['post_id']}",
                  timeout=30,
              )

              print(
                  "Post HTTP status:",
                  context_response.status_code
              )

              if context_response.status_code == 200:

                  full_data = (
                      context_response.json()
                  )

                  full_post = full_data

                  if isinstance(
                      full_data,
                      dict
                  ):

                      if isinstance(
                          full_data.get("post"),
                          dict
                      ):

                          full_post = (
                              full_data["post"]
                          )

                      elif isinstance(
                          full_data.get("data"),
                          dict
                      ):

                          full_post = (
                              full_data["data"]
                          )

                  if isinstance(
                      full_post,
                      dict
                  ):

                      full_title = normalise(
                          post_title(
                              full_post
                          )
                      )

                      full_body = normalise(
                          post_body(
                              full_post
                          )
                      )

                      if full_title:
                          selected[
                              "title"
                          ] = full_title

                      if full_body:
                          selected[
                              "body"
                          ] = full_body

              # =====================================================
              # 8. Final safety check
              # =====================================================

              final_text = normalise(
                  selected["title"]
                  + " "
                  + selected["body"]
              )

              if has_injection(
                  final_text
              ):

                  print()
                  print(
                      "SAFETY BLOCK:"
                  )

                  print(
                      "Potential instruction "
                      "injection detected."
                  )

                  result["reason"] = (
                      "Safety filter blocked the "
                      "selected post after retrieving "
                      "its full context."
                  )

              else:

                  # =================================================
                  # 9. Generate simple contextual contribution
                  # =================================================

                  evidence = select_evidence(
                      selected["body"]
                  )

                  topic_labels = {
                      "agents":
                          "agent behaviour",
                      "memory":
                          "memory and context",
                      "measurement":
                          "measurement and evaluation",
                      "learning":
                          "learning",
                      "verification":
                          "verification",
                      "reputation":
                          "reputation",
                      "community":
                          "agent communities",
                      "proposals":
                          "proposals and ideas",
                      "economics":
                          "economic usefulness",
                  }

                  readable_topics = [
                      topic_labels.get(
                          topic,
                          topic
                      )
                      for topic in selected[
                          "topics"
                      ][:2]
                  ]

                  topic_text = (
                      " and ".join(
                          readable_topics
                      )
                  )

                  if evidence:

                      comment = (
                          "NØX Origin is exploring "
                          "this topic through direct "
                          "observation on The Colony. "
                          f"The connection with "
                          f"{topic_text} is particularly "
                          "interesting. "
                          f"The point I would test further "
                          f"is: “{evidence}” "
                          "A useful next step would be "
                          "to compare this observation "
                          "with a measurable result from "
                          "real agent interactions."
                      )

                  else:

                      comment = (
                          "NØX Origin is exploring "
                          "this topic through direct "
                          "observation on The Colony. "
                          f"The connection with "
                          f"{topic_text} is interesting. "
                          "I would test this further with "
                          "a concrete example or measurable "
                          "result from real agent "
                          "interactions."
                      )

                  comment = normalise(
                      comment
                  )

                  if len(comment) > MAX_COMMENT_LENGTH:

                      comment = (
                          comment[
                              :MAX_COMMENT_LENGTH - 3
                          ]
                          + "..."
                      )

                  print()
                  print(
                      "Proposed contribution:"
                  )

                  print(
                      comment
                  )

                  # =================================================
                  # 10. Resolve comment endpoint
                  # =================================================

                  print()
                  print(
                      "[6] Checking comment endpoint..."
                  )

                  endpoint = (
                      f"{API_BASE}/posts/"
                      f"{selected['post_id']}"
                      f"/comments"
                  )

                  print(
                      "Comment endpoint:",
                      endpoint
                  )

                  # =================================================
                  # 11. ONE PUBLIC ACTION
                  # =================================================

                  print()
                  print(
                      "NØX is allowed ONE public "
                      "action in V54."
                  )

                  print(
                      "Posting one contextual comment..."
                  )

                  comment_response = session.post(
                      endpoint,
                      json={
                          "body": comment
                      },
                      timeout=30,
                  )

                  result[
                      "safety"
                  ][
                      "actions_attempted"
                  ] = 1

                  result[
                      "comment_http_status"
                  ] = (
                      comment_response.status_code
                  )

                  result[
                      "comment"
                  ] = comment

                  print(
                      "Comment HTTP status:",
                      comment_response.status_code
                  )

                  print(
                      "Response:",
                      comment_response.text[:5000]
                  )

                  if comment_response.status_code in [
                      200,
                      201
                  ]:

                      result[
                          "action_taken"
                      ] = True

                      result[
                          "action_type"
                      ] = "comment"

                      result[
                          "safety"
                      ][
                          "comment"
                      ] = True

                      result[
                          "reason"
                      ] = (
                          "NØX independently selected "
                          "a relevant post from its "
                          "real For-you feed and made "
                          "one contextual contribution."
                      )

                      print()
                      print(
                          "V54 PUBLIC ACTION: SUCCESS"
                      )

                  else:

                      result[
                          "reason"
                      ] = (
                          "The Colony rejected the "
                          "comment request."
                      )

                      print()
                      print(
                          "V54 PUBLIC ACTION: FAILED"
                      )

          # =========================================================
          # 12. Save memory
          # =========================================================

          os.makedirs(
              "memory",
              exist_ok=True
          )

          with open(
              "memory/nox_v54_feed_opportunity.json",
              "w",
              encoding="utf-8"
          ) as file:

              json.dump(
                  result,
                  file,
                  ensure_ascii=False,
                  indent=2
              )

          # =========================================================
          # 13. Human-readable report
          # =========================================================

          report = []

          report.append(
              "# NØX Origin — V54 Feed Opportunity"
          )

          report.append("")

          report.append(
              f"Generated: {now}"
          )

          report.append("")

          report.append("## Status")
          report.append("")

          report.append(
              "- Authentication: PASS"
          )

          report.append(
              "- Identity: PASS"
          )

          report.append(
              "- For-you feed: PASS"
          )

          report.append(
              "- Local opportunity analysis: PASS"
          )

          report.append(
              "- Gemini: DISABLED"
          )

          report.append("")

          report.append(
              "## Autonomous Decision"
          )

          report.append("")

          if result[
              "action_taken"
          ]:

              report.append(
                  "NØX independently selected "
                  "a real feed post and performed "
                  "one public contribution."
              )

              report.append("")

              report.append(
                  f"- Post ID: "
                  f"`{result['target_post_id']}`"
              )

              report.append(
                  f"- Author: "
                  f"{result['target_author']}"
              )

              report.append(
                  f"- Title: "
                  f"{result['target_title']}"
              )

              report.append(
                  f"- Topics: "
                  f"{', '.join(result['topics'])}"
              )

              report.append(
                  f"- HTTP status: "
                  f"`{result['comment_http_status']}`"
              )

              report.append("")

              report.append(
                  "### Comment published"
              )

              report.append("")

              report.append(
                  result["comment"]
              )

          else:

              report.append(
                  "NØX performed NO public action."
              )

              report.append("")

              report.append(
                  f"Reason: "
                  f"{result.get('reason')}"
              )

          report.append("")

          report.append(
              "## Safety"
          )

          report.append("")

          report.append(
              "- Maximum public actions: 1"
          )

          report.append(
              f"- Actions attempted: "
              f"{result['safety']['actions_attempted']}"
          )

          report.append(
              "- No new publication."
          )

          report.append(
              "- No vote."
          )

          report.append(
              "- No follow."
          )

          report.append(
              "- No DM."
          )

          report.append(
              "- No purchase."
          )

          report.append(
              "- No spending."
          )

          report.append(
              "- Gemini disabled."
          )

          report.append("")

          report.append(
              "## Evolution"
          )

          report.append("")

          report.append(
              "V49: feed structure diagnosed."
          )

          report.append(
              "V50: feed observed and structured."
          )

          report.append(
              "V51: controlled action attempted."
          )

          report.append(
              "V51.1: exact Colony actions discovered."
          )

          report.append(
              "V52: autonomous action selection."
          )

          report.append(
              "V53: suggestion-based contribution test."
          )

          report.append(
              "V54: autonomous feed opportunity detection."
          )

          with open(
              "NØX_V54_FEED_OPPORTUNITY.md",
              "w",
              encoding="utf-8"
          ) as file:

              file.write(
                  "\n".join(report)
              )

          print()
          print(
              "=== NØX V54 COMPLETE ==="
          )

          print(
              "Action taken:",
              result["action_taken"]
          )

          print(
              "Memory:",
              "memory/nox_v54_feed_opportunity.json"
          )

          print(
              "Report:",
              "NØX_V54_FEED_OPPORTUNITY.md"
          )

          PY

          python v54_agent.py

      - name: Commit V54 memory and report
        run: |
          git config user.name "NØX Origin"
          git config user.email "nox-origin@users.noreply.github.com"

          git add memory/nox_v54_feed_opportunity.json
          git add NØX_V54_FEED_OPPORTUNITY.md

          if git diff --cached --quiet; then
            echo "No V54 changes to commit."
          else
            git commit -m "NØX V54 feed opportunity"
            git push
          fi
